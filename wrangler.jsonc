{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sm-link-shortener",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sm-link-shortener-db",
      "database_id": "5ecf7ba3-4ee8-4f3a-a1ae-0790ed9492b4",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "LINKS_KV",
      "id": "0a7ffdf92d0b4d679180b31e56caede2"
    }
  ],
  "vars": {
    "APP_URL": "https://sm-link-shortener.strongmommixpanel.workers.dev"
  }
}
